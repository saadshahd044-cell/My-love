<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>My Love ❤️</title>

<style>
*{
  box-sizing:border-box;
}

body{
  margin:0;
  min-height:100vh;
  font-family:Arial,Tahoma,sans-serif;
  background:linear-gradient(135deg,#fff3f7,#ffdce8,#fff8fa);
  color:#542b3b;
}

.screen{
  display:none;
  min-height:100vh;
  padding:25px;
  align-items:center;
  justify-content:center;
}

.screen.active{
  display:flex;
}

.card{
  width:min(92%,650px);
  padding:35px 25px;
  text-align:center;
  background:rgba(255,255,255,.86);
  border:1px solid #fff;
  border-radius:30px;
  box-shadow:0 20px 60px rgba(90,30,55,.16);
}

h1{
  color:#a33f68;
  font-size:42px;
  margin:10px 0 15px;
}

h2{
  color:#9b3b62;
}

p{
  font-size:18px;
  line-height:2;
}

.heart{
  font-size:65px;
}

input{
  width:100%;
  padding:16px;
  margin:15px 0;
  border:1px solid #e4b0c3;
  border-radius:18px;
  outline:none;
  text-align:center;
  font-size:18px;
}

button{
  border:0;
  padding:14px 27px;
  border-radius:20px;
  background:#a9436b;
  color:white;
  font-size:16px;
  cursor:pointer;
  box-shadow:0 8px 20px rgba(100,30,60,.18);
}

.heart-button{
  width:62px;
  height:62px;
  padding:0;
  border-radius:50%;
  font-size:25px;
}

.error{
  color:#c62828;
  min-height:25px;
}

.counter{
  margin:25px 0;
  padding:20px;
  border-radius:22px;
  background:#fff2f6;
  font-size:20px;
  font-weight:bold;
}

.memory img,
.memory video{
  width:100%;
  max-height:450px;
  object-fit:contain;
  border-radius:25px;
  cursor:pointer;
  box-shadow:0 12px 35px rgba(70,25,45,.16);
}

.hint{
  font-size:14px;
  color:#8c5c6e;
}

.modal{
  position:fixed;
  inset:0;
  display:none;
  align-items:center;
  justify-content:center;
  padding:20px;
  background:rgba(40,15,25,.6);
  z-index:999;
}

.modal.show{
  display:flex;
}

.message-box{
  position:relative;
  width:min(92%,520px);
  padding:45px 30px 35px;
  text-align:center;
  background:linear-gradient(145deg,#fff,#fff0f5);
  border:2px solid #e3a7bc;
  border-radius:28px;
  box-shadow:0 25px 80px rgba(0,0,0,.3);
}

.message-box:before{
  content:"♥";
  display:block;
  font-size:35px;
  color:#ad4169;
  margin-bottom:15px;
}

.message-box p{
  font-size:20px;
  line-height:2;
}

.close{
  position:absolute;
  top:10px;
  left:10px;
  width:38px;
  height:38px;
  padding:0;
  border-radius:50%;
  background:#efc0d0;
  color:#70334b;
  font-size:22px;
}

@media(max-width:500px){
  h1{
    font-size:35px;
  }

  p{
    font-size:17px;
  }
}
</style>
</head>

<body>

<!-- PASSWORD -->
<section id="login" class="screen active">

  <div class="card">

    <div class="heart">❤️</div>

    <h1>My Love</h1>

    <p>Enter the password to continue</p>

    <form id="loginForm">

      <input
        id="password"
        type="password"
        placeholder="Password"
        autocomplete="off"
      >

      <button
        class="heart-button"
        type="submit">
        ❤️
      </button>

      <p id="error" class="error"></p>

    </form>

  </div>

</section>


<!-- LOVE MESSAGE -->
<section id="love" class="screen">

  <div class="card">

    <div class="heart">❤️</div>

    <h1>My Love</h1>

    <p>
      عايزك تعرف إني بحبك أوي أوي،
      وملقيتش أحلى من الفكرة دي أعملها،
      هجمع صورنا كلها مع بعض،
      وربنا يخليك ليا يارب ❤️
    </p>

    <button onclick="showScreen('story')">
      كمّل معايا ❤️
    </button>

  </div>

</section>


<!-- STORY -->
<section id="story" class="screen">

  <div class="card">

    <h2>بدايتنا ❤️</h2>

    <p>مع بعض من سبتمبر 2024</p>

    <div id="counter" class="counter"></div>

    <p>
      وكل ثانية بتعدي، بحبك أكثر ❤️
    </p>

    <button onclick="showScreen('memories')">
      Our Lovely Memories ♥️
    </button>

  </div>

</section>


<!-- MEMORIES -->
<section id="memories" class="screen">

  <div class="card">

    <h2>ذكرياتنا ❤️</h2>

    <p>
      دوس مرتين على الصورة عشان الرسالة تظهر لك ♥
    </p>

    <div class="memory">

      <img
        id="memoryImage"
        src="https://placehold.co/900x600/fff0f5/a13f68?text=Our+Memory"
        alt="Our Memory"
      >

    </div>

    <p class="hint">
      اضغط مرتين على الصورة عشان الرسالة تظهر ✨
    </p>

    <button onclick="nextMemory()">
      نكمل الحكاية ❤️
    </button>

  </div>

</section>


<!-- MESSAGE -->
<div id="messageModal" class="modal">

  <div class="message-box">

    <button
      class="close"
      onclick="closeMessage()">
      ×
    </button>

    <p id="messageText"></p>

  </div>

</div>


<script>

/* =========================
   PASSWORD
========================= */

const PASSWORD = "love";


document
.getElementById("loginForm")
.addEventListener("submit", function(event){

  event.preventDefault();

  const enteredPassword =
    document
    .getElementById("password")
    .value
    .trim()
    .toLowerCase();

  const error =
    document.getElementById("error");


  if(enteredPassword === PASSWORD){

    error.textContent = "";

    showScreen("love");

  }

  else{

    error.textContent =
      "الباسورد غلط ❤️";

  }

});


/* =========================
   SCREEN
========================= */

function showScreen(id){

  document
  .querySelectorAll(".screen")
  .forEach(function(screen){

    screen.classList.remove("active");

  });


  const selected =
    document.getElementById(id);


  if(selected){

    selected.classList.add("active");

  }

}


/* =========================
   COUNTER
========================= */

const startDate =
  new Date("2024-09-01T00:00:00");


function updateCounter(){

  const now = new Date();

  let seconds =
    Math.floor(
      (now - startDate) / 1000
    );


  const days =
    Math.floor(seconds / 86400);

  seconds %= 86400;


  const hours =
    Math.floor(seconds / 3600);

  seconds %= 3600;


  const minutes =
    Math.floor(seconds / 60);

  const secs =
    seconds % 60;


  document
  .getElementById("counter")
  .textContent =
    `${days} يوم • ${hours} ساعة • ${minutes} دقيقة • ${secs} ثانية ❤️`;

}


updateCounter();

setInterval(updateCounter,1000);


/* =========================
   MEMORIES
========================= */

const memories = [

  {
    image:
    "https://placehold.co/900x600/fff0f5/a13f68?text=Memory+1",

    message:
    "أجمل حاجة في الذكرى دي إنها بتفكرني قد إيه وجودك في حياتي مميز ❤️"
  },

  {
    image:
    "https://placehold.co/900x600/ffe5ee/a13f68?text=Memory+2",

    message:
    "كل لحظة معاك بتتحول لذكرى بحب أرجعلها كل مرة ❤️"
  },

  {
    image:
    "https://placehold.co/900x600/fff3f7/a13f68?text=Memory+3",

    message:
    "مهما الوقت يعدي، هتفضل أجمل جزء في حكايتي ❤️"
  }

];


let currentMemory = 0;


const memoryImage =
  document.getElementById("memoryImage");


memoryImage.ondblclick =
  function(){

    openMessage();

  };


function nextMemory(){

  currentMemory++;

  if(
    currentMemory >= memories.length
  ){

    currentMemory = 0;

  }


  const memory =
    memories[currentMemory];


  memoryImage.src =
    memory.image;


  memoryImage.ondblclick =
    function(){

      document
      .getElementById("messageText")
      .textContent =
        memory.message;

      openMessage();

    };

}


/* =========================
   MESSAGE
========================= */

function openMessage(){

  const memory =
    memories[currentMemory];


  document
  .getElementById("messageText")
  .textContent =
    memory.message;


  document
  .getElementById("messageModal")
  .classList.add("show");

}


function closeMessage(){

  document
  .getElementById("messageModal")
  .classList.remove("show");

}


document
.getElementById("messageModal")
.addEventListener(
  "click",
  function(event){

    if(event.target === this){

      closeMessage();

    }

  }
);

</script>

</body>
</html>
